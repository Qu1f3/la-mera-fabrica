// Esquema de base de datos — La Mera Fábrica
//
// Convención deliberada: los modelos y campos usan nombres en español para que
// coincidan con el dominio del negocio y con el documento de Fase 0 (ver
// propuesta-la-mera-fabrica.md). El resto del código (funciones, componentes,
// variables) usa convención en inglés, como es estándar en el ecosistema.
//
// Decisiones clave de este modelo (ver Fase 0, sección 9):
// - `Producto` es una sola tabla para mosaicos y molduras, con `tipo` como
//   discriminante. Los atributos que comparten (estilo, acabado, color,
//   aplicación) son columnas propias; lo que difiere por tipo (dimensiones de
//   pieza, cobertura por caja, longitud por pieza, etc.) vive en el campo
//   `especificaciones` (JSON), para no forzar un esquema rígido ni migrar la
//   base de datos cada vez que aparece un atributo técnico nuevo.
// - `ProductoRelacionado` distingue "moldura a juego" (complementario) de
//   "también te puede interesar" (similar) — es una relación con significado,
//   no un campo de texto libre.
// - No existe un campo de precio público. `Configuracion` es una fila única
//   editable desde el panel con los datos del negocio (WhatsApp, horario,
//   dirección, redes) — nunca hardcodeados en el código.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Catálogo
// ---------------------------------------------------------------------------

enum TipoProducto {
  MOSAICO
  MOLDURA
}

enum Disponibilidad {
  DISPONIBLE
  BAJO_PEDIDO
  AGOTADO
  DESCONTINUADO
}

enum TipoRelacion {
  COMPLEMENTARIO // ej: la moldura a juego de un mosaico
  SIMILAR // ej: otro producto parecido en estilo
}

model Categoria {
  id            String     @id @default(cuid())
  nombre        String
  slug          String     @unique
  descripcion   String?
  orden         Int        @default(0)
  activo        Boolean    @default(true)
  productos     Producto[]
  creadoEn      DateTime   @default(now())
  actualizadoEn DateTime   @updatedAt

  @@map("categorias")
}

model Producto {
  id             String         @id @default(cuid())
  sku            String?        @unique
  nombre         String
  slug           String         @unique
  tipo           TipoProducto
  descripcion    String?
  categoriaId    String?
  categoria      Categoria?     @relation(fields: [categoriaId], references: [id])
  estilo         String?
  acabado        String?
  colores        String[]       @default([])
  aplicaciones   String[]       @default([])
  disponibilidad Disponibilidad @default(DISPONIBLE)
  destacado      Boolean        @default(false)
  activo         Boolean        @default(true)

  // Datos técnicos específicos por tipo (dimensiones de pieza, cobertura por
  // caja para mosaico; longitud de pieza y perfil para moldura, etc.).
  // Estructura sugerida, no forzada por el esquema:
  //   mosaico: { largoCm, anchoCm, espesorMm, coberturaCajaM2, piezasPorCaja }
  //   moldura: { longitudPiezaCm, perfilMm, altoMm }
  especificaciones Json?

  // Precio de venta actual. NUNCA se usa directo en un pedido ya creado —
  // ItemPedido.precioUnitario guarda su propia copia congelada (ver el
  // sistema de gestion, Fase 2).
  precioActual Decimal? @db.Decimal(10, 2)

  imagenes ImagenProducto[]

  relacionadoDesde ProductoRelacionado[] @relation("ProductoOrigen")
  relacionadoHacia ProductoRelacionado[] @relation("ProductoDestino")

  itemsCotizacion ItemCotizacion[]

  // Sistema de gestion (pedidos internos, distintos de las cotizaciones
  // del sitio publico)
  itemsPedido         ItemPedido[]
  pagoUnitario        PagoUnitarioProducto?
  registrosProduccion RegistroProduccion[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([tipo])
  @@index([categoriaId])
  @@map("productos")
}

model ImagenProducto {
  id         String   @id @default(cuid())
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  url        String
  alt        String?
  orden      Int      @default(0)
  creadoEn   DateTime @default(now())

  @@index([productoId])
  @@map("imagenes_producto")
}

// Relación dirigida producto -> relacionado, con el tipo de relación.
// Se guarda en un solo sentido; la UI decide si la muestra también en el
// producto destino (normalmente sí, para "moldura a juego" recíproca).
model ProductoRelacionado {
  id            String       @id @default(cuid())
  productoId    String
  producto      Producto     @relation("ProductoOrigen", fields: [productoId], references: [id], onDelete: Cascade)
  relacionadoId String
  relacionado   Producto     @relation("ProductoDestino", fields: [relacionadoId], references: [id], onDelete: Cascade)
  tipoRelacion  TipoRelacion

  @@unique([productoId, relacionadoId])
  @@map("productos_relacionados")
}

// ---------------------------------------------------------------------------
// Cotización
// ---------------------------------------------------------------------------

enum EstadoCotizacion {
  NUEVA
  CONTACTADO
  CERRADA
}

enum UnidadCotizacion {
  M2 // mosaico: metros cuadrados
  ML // moldura: metros lineales
}

model SolicitudCotizacion {
  id            String           @id @default(cuid())
  nombreCliente String
  telefono      String
  email         String?
  notas         String?
  estado        EstadoCotizacion @default(NUEVA)
  items         ItemCotizacion[]
  creadoEn      DateTime         @default(now())
  actualizadoEn DateTime         @updatedAt

  @@index([estado])
  @@map("solicitudes_cotizacion")
}

model ItemCotizacion {
  id          String              @id @default(cuid())
  solicitudId String
  solicitud   SolicitudCotizacion @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  productoId  String
  producto    Producto            @relation(fields: [productoId], references: [id])
  // Opcional a propósito: un cliente puede no saber cuántos m²/ml necesita
  // todavía y aun así querer que le cotices el producto (ver Fase 3).
  cantidad    Decimal?            @db.Decimal(10, 2)
  unidad      UnidadCotizacion
  notas       String?

  @@index([solicitudId])
  @@map("items_cotizacion")
}

// ---------------------------------------------------------------------------
// Contenido editable desde el panel
// ---------------------------------------------------------------------------

model Banner {
  id          String    @id @default(cuid())
  titulo      String
  subtitulo   String?
  imagenUrl   String?
  enlace      String?
  orden       Int       @default(0)
  activo      Boolean   @default(true)
  fechaInicio DateTime?
  fechaFin    DateTime?
  creadoEn    DateTime  @default(now())

  @@map("banners")
}

// Bloques de contenido de secciones fijas del sitio (ej: "nosotros",
// "historia"). `clave` identifica la sección; el contenido real se llena
// desde el panel cuando exista información real del negocio.
model SeccionContenido {
  id            String   @id @default(cuid())
  clave         String   @unique
  titulo        String
  cuerpo        String?
  imagenUrl     String?
  actualizadoEn DateTime @updatedAt

  @@map("secciones_contenido")
}

model Faq {
  id        String  @id @default(cuid())
  pregunta  String
  respuesta String
  orden     Int     @default(0)
  activo    Boolean @default(true)

  @@map("faqs")
}

// Solo testimonios reales, cargados por el administrador. Si no hay ninguno
// activo, la sección correspondiente del sitio simplemente no se muestra.
model Testimonio {
  id            String   @id @default(cuid())
  nombreCliente String
  texto         String
  calificacion  Int?
  fotoUrl       String?
  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())

  @@map("testimonios")
}

// Fila única con los datos reales del negocio. Se edita desde el panel;
// mientras no exista información real, estos campos quedan en null y el
// sitio lo trata como estado pendiente, no como dato inventado.
model Configuracion {
  id                String   @id @default("global")
  whatsappNumero    String?
  horarioAtencion   String?
  direccion         String?
  mapaUrl           String?
  facebookUrl       String?
  instagramUrl      String?

  // Sistema de gestion: monto configurable de mezcla (hoy L.130). Se copia
  // a RegistroMezcla.monto en cada registro nuevo -- cambiarlo aqui no
  // altera registros pasados.
  montoMezclaActual Decimal? @db.Decimal(10, 2)

  actualizadoEn     DateTime @updatedAt

  @@map("configuracion")
}

// ---------------------------------------------------------------------------
// Administración
// ---------------------------------------------------------------------------

enum RolAdmin {
  ADMIN
  EMPLEADO
}

// Perfil de aplicación para cada usuario de Supabase Auth con acceso al
// panel. ADMIN ve todo el panel; EMPLEADO es un "mini administrador" --
// solo ve Pedidos, Producción, Extras, Pagos semanales, Inventario y
// Reportes (ver el route group "(solo-dueno)" y AdminNav.tsx para dónde se
// aplica ese límite). El default es EMPLEADO a propósito: si algún día se
// crea una fila de AdminUsuario sin especificar rol (a mano, por otro
// código, etc.), que falle "cerrado" -- de menos acceso, nunca de más -- en
// vez de dar acceso total a alguien por accidente.
// No es obligatorio para iniciar sesión en la Fase 1 (ver src/lib/supabase/proxy.ts).
model AdminUsuario {
  id         String   @id @default(cuid())
  authUserId String   @unique
  nombre     String
  email      String   @unique
  rol        RolAdmin @default(EMPLEADO)
  activo     Boolean  @default(true)

  // Sistema de gestion: quien hizo cada cambio de estado / cada riego
  cambiosEstadoPedido HistorialEstadoPedido[]
  riegosRegistrados   RegistroRiego[]

  creadoEn   DateTime @default(now())

  @@map("admin_usuarios")
}

// ---------------------------------------------------------------------------
// Sistema de gestion -- Pedidos
// ---------------------------------------------------------------------------
// Todo lo que sigue es aditivo (Fase 2 del sistema de gestion, aprobada por
// el usuario 2026-08-25): no modifica ninguna tabla/columna del catalogo o
// del sitio publico que ya existia arriba.

enum EstadoPedido {
  PEDIDO_RECIBIDO
  EN_PRODUCCION
  EN_SECADO
  EN_RIEGO
  LISTO
  ENTREGADO
  CANCELADO
}

enum EstadoEntrega {
  PENDIENTE
  LISTO
  EN_ENTREGA
  ENTREGADO
  CANCELADO
}

model Cliente {
  id            String   @id @default(cuid())
  nombre        String
  telefono      String
  notas         String?
  pedidos       Pedido[]
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@map("clientes")
}

// montoTotal / montoAnticipo / saldoPendiente son columnas calculadas por la
// aplicacion a partir de los ItemPedido y el porcentajeAnticipo -- no se
// recalculan "al vuelo" en cada lectura. Cualquier cambio a los items o al
// porcentaje de anticipo debe recalcular estos tres campos en la misma
// operacion (ver src/lib/pedidoTotales.ts).
model Pedido {
  id                 String                  @id @default(cuid())
  codigo             String                  @unique
  clienteId          String
  cliente            Cliente                 @relation(fields: [clienteId], references: [id])
  fechaPrometida     DateTime?
  fechaEntregaReal   DateTime?
  porcentajeAnticipo Decimal                 @default(60) @db.Decimal(5, 2)
  montoAnticipo      Decimal                 @db.Decimal(10, 2)
  montoTotal         Decimal                 @db.Decimal(10, 2)
  saldoPendiente     Decimal                 @db.Decimal(10, 2)
  estado             EstadoPedido            @default(PEDIDO_RECIBIDO)
  // Se guarda sola al pasar a EN_SECADO -- de ahi se calculan los "dias de
  // secado transcurridos" en hora de Honduras (ver src/lib/fecha.ts).
  fechaInicioSecado  DateTime?
  notas              String?
  items              ItemPedido[]
  historial          HistorialEstadoPedido[]
  riegos             RegistroRiego[]
  entregas           Entrega[]
  ingresos           Ingreso[]
  creadoEn           DateTime                @default(now())
  actualizadoEn      DateTime                @updatedAt

  @@index([estado])
  @@index([clienteId])
  @@map("pedidos")
}

model ItemPedido {
  id       String @id @default(cuid())
  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  // Sin cascada hacia Producto (igual que ItemCotizacion): borrar un
  // producto no debe borrar el historial de pedidos que lo usaron.
  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  // Copiados del producto al crear el pedido -- nunca se leen "en vivo"
  // desde Producto despues de este punto.
  categoria String?
  diseno    String?
  color     String?

  cantidad       Decimal @db.Decimal(10, 2)
  // Snapshot historico: el precio del producto el dia del pedido.
  precioUnitario Decimal @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(10, 2)

  @@index([pedidoId])
  @@map("items_pedido")
}

model HistorialEstadoPedido {
  id             String       @id @default(cuid())
  pedidoId       String
  pedido         Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  estado         EstadoPedido
  adminUsuarioId String
  adminUsuario   AdminUsuario @relation(fields: [adminUsuarioId], references: [id])
  notas          String?
  creadoEn       DateTime     @default(now())

  @@index([pedidoId])
  @@map("historial_estado_pedido")
}

// El riego lo hace personalmente el administrador (nunca empleados).
model RegistroRiego {
  id             String       @id @default(cuid())
  pedidoId       String
  pedido         Pedido       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  adminUsuarioId String
  adminUsuario   AdminUsuario @relation(fields: [adminUsuarioId], references: [id])
  observacion    String?
  creadoEn       DateTime     @default(now())

  @@index([pedidoId])
  @@map("registros_riego")
}

// Un evento de entrega concreto. Lo normal es una sola fila por pedido;
// solo hay mas de una si el pedido se reparte en tandas (confirmado por el
// usuario 2026-08-25).
model Entrega {
  id              String        @id @default(cuid())
  pedidoId        String
  pedido          Pedido        @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  fechaProgramada DateTime?
  fechaReal       DateTime?
  estado          EstadoEntrega @default(PENDIENTE)
  notas           String?
  creadoEn        DateTime      @default(now())
  actualizadoEn   DateTime      @updatedAt

  @@index([pedidoId])
  @@map("entregas")
}

// ---------------------------------------------------------------------------
// Sistema de gestion -- Empleados y produccion
// ---------------------------------------------------------------------------

enum EstadoPagoSemanal {
  PENDIENTE
  PAGADO
}

model Empleado {
  id            String              @id @default(cuid())
  nombre        String
  telefono      String?
  activo        Boolean             @default(true)
  notas         String?
  fechaIngreso  DateTime?
  producciones  RegistroProduccion[]
  mezclas       RegistroMezcla[]
  extras        PagoExtraEmpleado[]
  pagos         PagoEmpleado[]
  creadoEn      DateTime            @default(now())
  actualizadoEn DateTime            @updatedAt

  @@map("empleados")
}

// Valor actual configurable por producto/diseno. Al crear un
// RegistroProduccion se copia este monto -- cambiarlo despues no altera
// registros ya creados.
model PagoUnitarioProducto {
  id            String   @id @default(cuid())
  productoId    String   @unique
  producto      Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)
  monto         Decimal  @db.Decimal(10, 2)
  actualizadoEn DateTime @updatedAt

  @@map("pago_unitario_producto")
}

model RegistroProduccion {
  id                  String   @id @default(cuid())
  fecha               DateTime @default(now())
  empleadoId          String
  empleado            Empleado @relation(fields: [empleadoId], references: [id])
  productoId          String
  producto            Producto @relation(fields: [productoId], references: [id])
  cantidadProducida   Int
  unidadesDefectuosas Int      @default(0)
  // Snapshot: copiado de PagoUnitarioProducto al momento del registro.
  pagoUnitario        Decimal  @db.Decimal(10, 2)
  totalGanado         Decimal  @db.Decimal(10, 2)
  notas               String?
  creadoEn            DateTime @default(now())

  @@index([empleadoId])
  @@index([fecha])
  @@map("registros_produccion")
}

// Hoy solo un empleado hace mezcla, pero no se restringe a nivel de schema.
model RegistroMezcla {
  id         String   @id @default(cuid())
  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id])
  fecha      DateTime @default(now())
  // Snapshot de Configuracion.montoMezclaActual al momento del registro.
  monto      Decimal  @db.Decimal(10, 2)
  notas      String?
  creadoEn   DateTime @default(now())

  @@index([empleadoId])
  @@map("registros_mezcla")
}

// Si un tipo de extra SUMA o RESTA del pago semanal del empleado -- ej.
// "Cargar Ladrillo" suma, "Prestamo"/"Adelanto" resta. Enum nuevo (no se le
// agrega un valor a uno existente), seguro de usar como default en la misma
// migracion -- ver "MIGRACIONES DE POSTGRES CON ENUMS" en la memoria del
// proyecto para por que eso importa.
enum SignoPagoExtra {
  SUMA
  RESTA
}

// Catalogo configurable de tipos de extra (ej: "Cargar pedido al camion").
model TipoPagoExtra {
  id            String              @id @default(cuid())
  descripcion   String
  montoSugerido Decimal?            @db.Decimal(10, 2)
  activo        Boolean             @default(true)
  // Default SUMA para no afectar los tipos ya creados (todos eran "suma" de
  // hecho). PagoExtraEmpleado.monto se guarda ya con el signo aplicado (ver
  // registrarPagoExtra en actions.ts) -- mismo patron de snapshot historico
  // que descripcion/monto: si el tipo cambia de signo despues, los pagos ya
  // registrados no cambian.
  signo         SignoPagoExtra      @default(SUMA)
  extras        PagoExtraEmpleado[]

  @@map("tipos_pago_extra")
}

model PagoExtraEmpleado {
  id              String         @id @default(cuid())
  empleadoId      String
  empleado        Empleado       @relation(fields: [empleadoId], references: [id])
  tipoPagoExtraId String?
  tipoPagoExtra   TipoPagoExtra? @relation(fields: [tipoPagoExtraId], references: [id])
  fecha           DateTime       @default(now())
  // Copiada (no se lee en vivo de TipoPagoExtra), igual que el monto.
  descripcion     String
  monto           Decimal        @db.Decimal(10, 2)
  notas           String?
  creadoEn        DateTime       @default(now())

  @@index([empleadoId])
  @@map("pagos_extra_empleado")
}

model PagoEmpleado {
  id              String            @id @default(cuid())
  empleadoId      String
  empleado        Empleado          @relation(fields: [empleadoId], references: [id])
  semanaInicio    DateTime
  semanaFin       DateTime
  totalProduccion Decimal           @db.Decimal(10, 2)
  totalMezcla     Decimal           @db.Decimal(10, 2)
  totalExtras     Decimal           @db.Decimal(10, 2)
  totalGanado     Decimal           @db.Decimal(10, 2)
  estado          EstadoPagoSemanal @default(PENDIENTE)
  fechaPago       DateTime?
  montoPagado     Decimal?          @db.Decimal(10, 2)
  notas           String?
  creadoEn        DateTime          @default(now())
  actualizadoEn   DateTime          @updatedAt
  // Lado inverso del gasto automatico -- ver Gasto.pagoEmpleadoId arriba.
  gasto           Gasto?

  @@unique([empleadoId, semanaInicio])
  @@map("pagos_empleado")
}

// ---------------------------------------------------------------------------
// Sistema de gestion -- Inventario
// ---------------------------------------------------------------------------

enum TipoMovimientoInventario {
  ENTRADA
  SALIDA
}

model Proveedor {
  id         String               @id @default(cuid())
  nombre     String
  telefono   String?
  notas      String?
  activo     Boolean              @default(true)
  materiales MaterialInventario[]
  compras    Compra[]
  creadoEn   DateTime             @default(now())

  @@map("proveedores")
}

model MaterialInventario {
  id             String                 @id @default(cuid())
  nombre         String
  // Unidad base en la que se lleva el stock (cantidadActual/cantidadMinima).
  // Ej: "kg".
  unidadMedida   String
  // Cuanta unidadMedida trae cada "unidad" de compra/movimiento. Ej: si se
  // compra cemento en bolsas de 42.5kg, unidadMedida="kg" y
  // cantidadPorUnidad=42.5 -- asi el admin registra movimientos contando
  // bolsas (como compra de verdad) y el sistema calcula el stock real en kg.
  // Si no aplica conversion (se compra y se usa en la misma unidad), queda
  // en 1.
  cantidadPorUnidad Decimal             @default(1) @db.Decimal(10, 2)
  cantidadActual Decimal                @default(0) @db.Decimal(10, 2)
  cantidadMinima Decimal                @default(0) @db.Decimal(10, 2)
  costo          Decimal?               @db.Decimal(10, 2)
  proveedorId    String?
  proveedor      Proveedor?             @relation(fields: [proveedorId], references: [id])
  activo         Boolean                @default(true)
  notas          String?
  movimientos    MovimientoInventario[]
  creadoEn       DateTime               @default(now())
  actualizadoEn  DateTime               @updatedAt

  @@map("materiales_inventario")
}

// Las salidas son manuales -- no se descuenta automatico por produccion.
model MovimientoInventario {
  id         String                   @id @default(cuid())
  materialId String
  material   MaterialInventario       @relation(fields: [materialId], references: [id])
  tipo       TipoMovimientoInventario
  // Cantidad en "unidades de compra" (ej: bolsas), no en unidadMedida.
  cantidad   Decimal                  @db.Decimal(10, 2)
  // Snapshot de MaterialInventario.cantidadPorUnidad al momento del
  // movimiento (mismo criterio de snapshot que el resto del proyecto) --
  // si despues cambia el tamano de la presentacion, los movimientos viejos
  // no se reinterpretan. cantidad * cantidadPorUnidad = cuanto se
  // sumo/resto del stock real (en unidadMedida) en este movimiento.
  cantidadPorUnidad Decimal             @default(1) @db.Decimal(10, 2)
  fecha      DateTime                 @default(now())
  compraId   String?
  compra     Compra?                  @relation(fields: [compraId], references: [id])
  // Costo por unidad de compra (ej: por bolsa), no por unidadMedida.
  costo      Decimal?                 @db.Decimal(10, 2)
  referencia String?
  motivo     String?
  notas      String?

  @@index([materialId])
  @@map("movimientos_inventario")
}

model Compra {
  id          String                 @id @default(cuid())
  proveedorId String
  proveedor   Proveedor              @relation(fields: [proveedorId], references: [id])
  fecha       DateTime               @default(now())
  montoTotal  Decimal                @db.Decimal(10, 2)
  notas       String?
  movimientos MovimientoInventario[]
  // Lado inverso del gasto automatico -- ver Gasto.compraId arriba.
  gasto       Gasto?

  // Compra "a credito": el proveedor no cobra al momento (ej. se paga el
  // pedido anterior cuando llega el siguiente). Default true (pagada de
  // una vez) para no afectar compras existentes ni el caso normal -- el
  // Gasto automatico de Finanzas solo se genera cuando pagada pasa a true
  // (al registrar la compra si es de contado, o al marcarla pagada despues
  // si fue a credito). Ver inventario/actions.ts::registrarMovimiento y
  // marcarCompraPagada.
  pagada    Boolean   @default(true)
  fechaPago DateTime?

  @@map("compras")
}

// ---------------------------------------------------------------------------
// Sistema de gestion -- Finanzas
// ---------------------------------------------------------------------------

enum TipoIngreso {
  VENTA
  ANTICIPO
  PAGO_FINAL
  OTRO
}

enum TipoGasto {
  MATERIALES
  EMPLEADOS
  COMBUSTIBLE
  ELECTRICIDAD
  AGUA
  MANTENIMIENTO
  TRANSPORTE
  REPARACIONES
  OTROS
}

model Ingreso {
  id          String      @id @default(cuid())
  categoria   TipoIngreso
  monto       Decimal     @db.Decimal(10, 2)
  fecha       DateTime    @default(now())
  pedidoId    String?
  pedido      Pedido?     @relation(fields: [pedidoId], references: [id])
  descripcion String?
  notas       String?

  @@index([fecha])
  @@map("ingresos")
}

model Gasto {
  id          String    @id @default(cuid())
  categoria   TipoGasto
  monto       Decimal   @db.Decimal(10, 2)
  fecha       DateTime  @default(now())
  descripcion String?
  notas       String?
  // Un gasto de categoria EMPLEADOS/MATERIALES es 100% automatico -- se
  // genera solo al marcar un pago semanal como pagado o al registrar una
  // compra de inventario (ver pagos-semanales/actions.ts e
  // inventario/actions.ts). Nunca se crea a mano desde Finanzas.
  pagoEmpleadoId String?       @unique
  pagoEmpleado   PagoEmpleado? @relation(fields: [pagoEmpleadoId], references: [id])
  compraId       String?       @unique
  compra         Compra?       @relation(fields: [compraId], references: [id])

  @@index([fecha])
  @@map("gastos")
}

// ---------------------------------------------------------------------------
// Sistema de gestion -- Mensajeria
// ---------------------------------------------------------------------------

model PlantillaMensaje {
  id            String   @id @default(cuid())
  clave         String   @unique
  nombre        String
  cuerpo        String
  activo        Boolean  @default(true)
  actualizadoEn DateTime @updatedAt

  @@map("plantillas_mensaje")
}
