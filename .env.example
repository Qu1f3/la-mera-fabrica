# Copia este archivo a .env y llena los valores reales.
# .env nunca se sube a git (ver .gitignore) — cada quien (tu máquina, Vercel) tiene el suyo.

# --- Supabase: Project Settings -> API ---
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Sensible: solo se usa en el servidor, nunca se expone al navegador.
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Supabase: Project Settings -> Database -> Connection string ---
# Usa el pooler (Supavisor) para las dos variables, no la conexión "directa"
# (db.<ref>.supabase.co) — esa suele resolver solo por IPv6 y falla en redes
# o despliegues que no lo soportan (incluyendo Vercel serverless).
#
# DATABASE_URL: pooler en modo transacción, puerto 6543 — la usa la app.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL: mismo pooler en modo sesión, puerto 5432 — la usa Prisma Migrate.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:[PASSWORD]@aws-0-xxxxx.pooler.supabase.com:5432/postgres"

# --- Fase 5: SEO y analítica (opcionales) ---
# URL pública real del sitio, SIN barra al final (ej: la que te da Vercel,
# o tu dominio propio si conectas uno). La usan sitemap.xml, robots.txt y
# las etiquetas <meta> para armar enlaces completos. Mientras no la pongas,
# el sitio funciona igual, pero esos enlaces apuntan a localhost.
NEXT_PUBLIC_SITE_URL="https://tu-sitio.vercel.app"

# ID de medición de Google Analytics 4 (Admin -> Flujos de datos -> tu flujo web,
# empieza con "G-"). Es gratis. Mientras lo dejes vacío, no se carga ningún
# script de analítica ni se manda ningún dato — el sitio simplemente no
# mide visitas todavía.
NEXT_PUBLIC_GA_ID=""
